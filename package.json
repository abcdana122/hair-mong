{
  "name": "hair-mong",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "vite hair-mong --config hair-mong/vite.config.js",
