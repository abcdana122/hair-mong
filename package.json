    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.8.3",
    "vite": "^8.0.12",
    "playwright": "^1.56.0"
